#!/bin/bash
# 初始化项目的 superwiki 知识库
# 用法: superwiki-init [--all|--codex|--opencode|--claude] [--hook] [项目路径]

set -e

usage() {
    echo "用法: superwiki-init [--all|--codex|--opencode|--claude] [--hook] [项目路径]"
    echo ""
    echo "默认初始化全部支持的项目级 skill 入口:"
    echo "  .agents/skills   -> ../.wiki/skills  (Codex / agent-compatible)"
    echo "  .opencode/skills -> ../.wiki/skills  (OpenCode)"
    echo "  .claude/skills   -> ../.wiki/skills  (Claude Code)"
    echo ""
    echo "可选:"
    echo "  --hook            安装 Codex UserPromptSubmit memory hook 到项目 .codex/"
}

PROJECT_DIR=""
INIT_CODEX=0
INIT_OPENCODE=0
INIT_CLAUDE=0
INIT_ALL=0
INIT_HOOK=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --all)
            INIT_ALL=1
            ;;
        --codex|--agents)
            INIT_CODEX=1
            ;;
        --opencode)
            INIT_OPENCODE=1
            ;;
        --claude|--claude-code)
            INIT_CLAUDE=1
            ;;
        --hook)
            INIT_HOOK=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "未知选项: $1" >&2
            usage >&2
            exit 2
            ;;
        *)
            if [ -n "$PROJECT_DIR" ]; then
                echo "只能指定一个项目路径" >&2
                usage >&2
                exit 2
            fi
            PROJECT_DIR="$1"
            ;;
    esac
    shift
done

PROJECT_DIR="${PROJECT_DIR:-.}"

if [ "$INIT_ALL" -eq 1 ] || { [ "$INIT_CODEX" -eq 0 ] && [ "$INIT_OPENCODE" -eq 0 ] && [ "$INIT_CLAUDE" -eq 0 ]; }; then
    INIT_CODEX=1
    INIT_OPENCODE=1
    INIT_CLAUDE=1
fi

cd "$PROJECT_DIR"

echo "初始化 superwiki 知识库..."
echo "项目路径: $(pwd)"

# 1. 创建知识库目录
mkdir -p .wiki/skills
echo "✅ 创建 .wiki/skills/"

resolve_link_dir() {
    LINK_PATH="$1"
    LINK_DIR="$(dirname "$LINK_PATH")"
    LINK_TARGET="$(readlink "$LINK_PATH")"
    case "$LINK_TARGET" in
        /*) TARGET_PATH="$LINK_TARGET" ;;
        *) TARGET_PATH="$LINK_DIR/$LINK_TARGET" ;;
    esac
    cd "$TARGET_PATH" 2>/dev/null && pwd -P
}

create_skill_link() {
    LABEL="$1"
    LINK_PATH="$2"
    TARGET="../.wiki/skills"
    WIKI_REALPATH="$(cd .wiki/skills && pwd -P)"

    mkdir -p "$(dirname "$LINK_PATH")"

    if [ -L "$LINK_PATH" ]; then
        LINK_TARGET="$(readlink "$LINK_PATH")"
        LINK_REALPATH="$(resolve_link_dir "$LINK_PATH" || true)"
        if [ "$LINK_REALPATH" = "$WIKI_REALPATH" ]; then
            echo "⏭️  $LINK_PATH 已正确指向 .wiki/skills，跳过 ($LABEL)"
        else
            echo "⚠️  $LINK_PATH 已存在但指向 $LINK_TARGET ($LABEL)"
            echo "    请手动确认后再调整为: $LINK_PATH → $TARGET"
        fi
    elif [ -e "$LINK_PATH" ]; then
        echo "⚠️  $LINK_PATH 已存在且不是符号链接，跳过 ($LABEL)"
        echo "    请手动确认后再调整为: $LINK_PATH → $TARGET"
    else
        ln -s "$TARGET" "$LINK_PATH"
        echo "✅ 创建 $LINK_PATH → $TARGET ($LABEL)"
    fi
}

install_project_memory_hook() {
    HOOK_SOURCE="$(cd "$(dirname "$0")" && pwd -P)/hooks/superwiki-memory-hook.py"
    HOOK_TEMPLATE="$(cd "$(dirname "$0")" && pwd -P)/hooks/hooks.json"

    if [ ! -f "$HOOK_SOURCE" ] || [ ! -f "$HOOK_TEMPLATE" ]; then
        echo "⚠️  superwiki memory hook 文件不存在，跳过"
        return
    fi

    mkdir -p .codex/hooks

    if [ -L .codex/hooks/superwiki-memory-hook.py ]; then
        ln -sf "$HOOK_SOURCE" .codex/hooks/superwiki-memory-hook.py
        echo "✅ 更新 .codex/hooks/superwiki-memory-hook.py"
    elif [ -e .codex/hooks/superwiki-memory-hook.py ]; then
        echo "⚠️  .codex/hooks/superwiki-memory-hook.py 已存在且不是符号链接，跳过"
    else
        ln -s "$HOOK_SOURCE" .codex/hooks/superwiki-memory-hook.py
        echo "✅ 创建 .codex/hooks/superwiki-memory-hook.py"
    fi

    if [ -e .codex/hooks.json ]; then
        echo "⚠️  .codex/hooks.json 已存在，未自动覆盖"
        echo "    请手动合并: $HOOK_TEMPLATE"
    else
        cp "$HOOK_TEMPLATE" .codex/hooks.json
        echo "✅ 创建 .codex/hooks.json"
        echo "    新增 hook 后需要在 Codex 中通过 /hooks 审核并信任"
    fi
}

# 2. 各 agent 的项目级 skill 入口
if [ "$INIT_CODEX" -eq 1 ]; then
    create_skill_link "Codex / agent-compatible" ".agents/skills"
fi

if [ "$INIT_OPENCODE" -eq 1 ]; then
    create_skill_link "OpenCode" ".opencode/skills"
fi

if [ "$INIT_CLAUDE" -eq 1 ]; then
    create_skill_link "Claude Code" ".claude/skills"
fi

if [ "$INIT_HOOK" -eq 1 ]; then
    install_project_memory_hook
fi

echo "完成！开始使用:"
echo "  skill(name=\"superwiki\")"
