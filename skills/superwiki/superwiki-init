#!/bin/bash
# 为项目接入 superwiki 知识库，或升级项目里的 superwiki-auto
# 用法: superwiki-init (--team|--personal) [--codex|--opencode|--claude|--cursor|--all] [项目路径]
#
# 注意: 变量一律写成 ${VAR}。macOS 自带的 bash 3.2 会把 $VAR 后紧跟的中文字节当成变量名。

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
TEMPLATE_DIR="${SCRIPT_DIR}/templates/superwiki-auto"
ENTRY_NAME="superwiki-auto"
LOCAL_FILE="references/local.md"

usage() {
    cat <<'EOF'
用法: superwiki-init (--team|--personal) [--codex|--opencode|--claude|--cursor|--all] [项目路径]

必须二选一指定模式:
  --team      团队模式：知识写在 .agents/skills/，随 Git 提交、团队共享。
              Codex / OpenCode 直接发现；--claude / --cursor / --all 额外创建
              .claude/skills、.cursor/skills -> ../.agents/skills。
              草稿规则 /.wiki/staging.md 写入项目目录的 .gitignore。
  --personal  个人模式：知识写在 .wiki/skills/，只在本机。
              默认链接全部运行时入口（.agents / .opencode / .claude / .cursor），
              可用运行时参数收窄；.wiki/ 与这些入口写入 .git/info/exclude。

两种模式都会在知识目录里生成 superwiki-auto（项目级自动入口）。
重复执行即升级：模板生成的文件按模板重写（模板已删除的文件一并移除），
保留 references/local.md 和全部 wiki-*。
发现任何冲突时以 ❌ 退出，不写入任何文件。
EOF
}

MODE=""
PROJECT_DIR=""
R_CODEX=0
R_OPENCODE=0
R_CLAUDE=0
R_CURSOR=0
R_ALL=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --team|--personal)
            NEW_MODE="${1#--}"
            if [ -n "${MODE}" ] && [ "${MODE}" != "${NEW_MODE}" ]; then
                echo "只能指定一种模式：--team 或 --personal" >&2
                usage >&2
                exit 2
            fi
            MODE="${NEW_MODE}"
            ;;
        --all) R_ALL=1 ;;
        --codex|--agents) R_CODEX=1 ;;
        --opencode) R_OPENCODE=1 ;;
        --claude|--claude-code) R_CLAUDE=1 ;;
        --cursor) R_CURSOR=1 ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "未知选项: $1" >&2
            usage >&2
            exit 2
            ;;
        *)
            if [ -n "${PROJECT_DIR}" ]; then
                echo "只能指定一个项目路径" >&2
                usage >&2
                exit 2
            fi
            PROJECT_DIR="$1"
            ;;
    esac
    shift
done

if [ -z "${MODE}" ]; then
    echo "缺少模式：请指定 --team 或 --personal" >&2
    usage >&2
    exit 2
fi

PROJECT_DIR="${PROJECT_DIR:-.}"
if [ ! -d "${PROJECT_DIR}" ]; then
    echo "项目路径不存在或不是目录: ${PROJECT_DIR}" >&2
    exit 1
fi
if [ ! -f "${TEMPLATE_DIR}/SKILL.md.tmpl" ] || [ ! -f "${SCRIPT_DIR}/VERSION" ]; then
    echo "superwiki 模板缺失: ${TEMPLATE_DIR}" >&2
    exit 1
fi
VERSION="$(tr -d '[:space:]' < "${SCRIPT_DIR}/VERSION")"

cd "${PROJECT_DIR}"
PROJECT_ROOT="$(pwd -P)"

# 模式相关的全部取值集中在这里，后面只读这些变量
if [ "${MODE}" = "team" ]; then
    WIKI_DIR=".agents/skills"
    LINK_TARGET="../.agents/skills"
    MODE_LABEL="团队模式"
    SHARING="正式知识随 Git 提交、团队共享，同事无需安装任何东西。"
    LINK_RULE="正式知识目录是实体目录，不沿软链接写入；"
    IGNORE_RULE="不生效时在项目目录的 \`.gitignore\` 增量补充精确规则 \`/.wiki/staging.md\`，"
    PERSIST_RULE="确认这些内容已被提交（提交由用户或获授权的任务完成）"
    [ "${R_ALL}" -eq 1 ] && { R_CLAUDE=1; R_CURSOR=1; }
    # Codex 与 OpenCode 直接读取 .agents/skills，只有 Claude Code 与 Cursor 需要入口
    R_CODEX=0
    R_OPENCODE=0
else
    WIKI_DIR=".wiki/skills"
    LINK_TARGET="../.wiki/skills"
    MODE_LABEL="个人模式"
    SHARING="正式知识只在本机，\`.wiki/\` 与各运行时入口已写入 \`.git/info/exclude\`，不进团队仓库。"
    LINK_RULE="各运行时入口（如 \`.agents/skills\`）是指向 \`.wiki/skills\` 的软链接，写入始终落在 \`.wiki/skills\` 下的实体路径；"
    IGNORE_RULE="不生效时在 \`.git/info/exclude\` 增量补充本项目的 \`.wiki/\` 规则（个人模式不改 \`.gitignore\`），"
    PERSIST_RULE="确认这些内容已写入正式模块"
    if [ "${R_ALL}" -eq 1 ] || { [ "${R_CODEX}" -eq 0 ] && [ "${R_OPENCODE}" -eq 0 ] && [ "${R_CLAUDE}" -eq 0 ] && [ "${R_CURSOR}" -eq 0 ]; }; then
        R_CODEX=1
        R_OPENCODE=1
        R_CLAUDE=1
        R_CURSOR=1
    fi
fi
DEST="${WIKI_DIR}/${ENTRY_NAME}"

LINKS=""
[ "${R_CODEX}" -eq 1 ] && LINKS="${LINKS} .agents/skills"
[ "${R_OPENCODE}" -eq 1 ] && LINKS="${LINKS} .opencode/skills"
[ "${R_CLAUDE}" -eq 1 ] && LINKS="${LINKS} .claude/skills"
[ "${R_CURSOR}" -eq 1 ] && LINKS="${LINKS} .cursor/skills"

# 1. 写入前检查：收集全部冲突，有任何一条就退出，不改任何文件
CONFLICTS=""
conflict() {
    CONFLICTS="${CONFLICTS}
   - $1"
}

link_is_ours() {
    [ -L "$1" ] && [ "$(readlink "$1")" = "${LINK_TARGET}" ]
}

has_knowledge() {
    for item in "$1"/wiki-* "$1"/wiki_* "$1/superwiki" "$1/${ENTRY_NAME}"; do
        [ -e "${item}" ] && return 0
    done
    return 1
}

if [ "${MODE}" = "team" ]; then
    if [ -e ".wiki/skills" ] || [ -L ".wiki/skills" ]; then
        conflict "已有个人模式知识目录 .wiki/skills；切换模式需要先手动迁移知识"
    fi
    if [ -L ".agents/skills" ]; then
        conflict ".agents/skills 是软链接（-> $(readlink .agents/skills)），团队模式需要实体目录"
    elif [ -e ".agents/skills" ] && [ ! -d ".agents/skills" ]; then
        conflict ".agents/skills 已存在且不是目录"
    elif [ -e ".agents/skills/superwiki" ]; then
        conflict "存在旧的项目版 .agents/skills/superwiki；先按迁移步骤整理并删除它"
    fi
else
    if [ -d ".agents/skills" ] && [ ! -L ".agents/skills" ] && has_knowledge ".agents/skills"; then
        conflict "项目已是团队模式（.agents/skills 下有 wiki-* 或 superwiki）；切换模式需要先手动迁移知识"
    fi
    if [ -L ".wiki/skills" ] || { [ -e ".wiki/skills" ] && [ ! -d ".wiki/skills" ]; }; then
        conflict ".wiki/skills 已存在且不是实体目录"
    fi
fi
if [ -L "${DEST}" ] || { [ -e "${DEST}" ] && [ ! -d "${DEST}" ]; }; then
    conflict "${DEST} 已存在且不是实体目录"
fi
for link in ${LINKS}; do
    if { [ -e "${link}" ] || [ -L "${link}" ]; } && ! link_is_ours "${link}"; then
        if [ -L "${link}" ]; then
            conflict "${link} 已是指向 $(readlink "${link}") 的软链接；可用运行时参数跳过该入口"
        else
            conflict "${link} 已存在且不是软链接；可用运行时参数跳过该入口"
        fi
    fi
done

if [ -n "${CONFLICTS}" ]; then
    echo "❌ 发现冲突，未写入任何文件:${CONFLICTS}" >&2
    exit 1
fi

IN_GIT=0
GIT_PREFIX=""
GIT_EXCLUDE=""
if command -v git >/dev/null 2>&1 && [ "$(git rev-parse --is-inside-work-tree 2>/dev/null || true)" = "true" ]; then
    IN_GIT=1
    GIT_PREFIX="$(git rev-parse --show-prefix)"
    GIT_EXCLUDE="$(git rev-parse --git-path info/exclude)"
fi

echo "superwiki: ${MODE_LABEL}"
echo "项目路径: ${PROJECT_ROOT}"

# 2. 生成或升级 superwiki-auto
OLD_VERSION=""
if [ -f "${DEST}/SKILL.md" ]; then
    OLD_VERSION="$(sed -n 's/^ *superwiki-template: *"\{0,1\}\([^"]*\)"\{0,1\} *$/\1/p' "${DEST}/SKILL.md" | head -n 1)"
    OLD_VERSION="${OLD_VERSION:-未知}"
fi

render() {
    sed -e "s|{{WIKI_DIR}}|${WIKI_DIR}|g" \
        -e "s|{{MODE}}|${MODE}|g" \
        -e "s|{{MODE_LABEL}}|${MODE_LABEL}|g" \
        -e "s|{{VERSION}}|${VERSION}|g" \
        -e "s|{{SHARING}}|${SHARING}|g" \
        -e "s|{{LINK_RULE}}|${LINK_RULE}|g" \
        -e "s|{{IGNORE_RULE}}|${IGNORE_RULE}|g" \
        -e "s|{{PERSIST_RULE}}|${PERSIST_RULE}|g" \
        "$1" > "$2.tmp"
    mv "$2.tmp" "$2"
}

if [ -d "${DEST}" ]; then
    (cd "${DEST}" && find . -type f | sed 's|^\./||' | sort) | while IFS= read -r rel; do
        [ "${rel}" = "${LOCAL_FILE}" ] && continue
        if [ ! -f "${TEMPLATE_DIR}/${rel}" ] && [ ! -f "${TEMPLATE_DIR}/${rel}.tmpl" ]; then
            rm -f "${DEST}/${rel}"
            echo "🗑️  移除模板已删除的文件: ${DEST}/${rel}"
        fi
    done
    find "${DEST}" -mindepth 1 -type d -empty -delete
fi

mkdir -p "${DEST}"
(cd "${TEMPLATE_DIR}" && find . -type f | sed 's|^\./||' | sort) | while IFS= read -r rel; do
    out="${rel%.tmpl}"
    mkdir -p "${DEST}/$(dirname "${out}")"
    if [ "${out}" = "${LOCAL_FILE}" ] && [ -e "${DEST}/${out}" ]; then
        echo "⏭️  保留项目专属约定: ${DEST}/${out}"
        continue
    fi
    render "${TEMPLATE_DIR}/${rel}" "${DEST}/${out}"
done

if [ -z "${OLD_VERSION}" ]; then
    echo "✅ 生成 ${DEST}（模板 ${VERSION}）"
elif [ "${OLD_VERSION}" = "${VERSION}" ]; then
    echo "✅ 重新生成 ${DEST}（模板 ${VERSION}，版本未变）"
else
    echo "✅ 升级 ${DEST}：${OLD_VERSION} -> ${VERSION}"
fi

# 3. 运行时入口与 Git 忽略规则
for link in ${LINKS}; do
    if link_is_ours "${link}"; then
        echo "⏭️  ${link} 已指向 ${WIKI_DIR}"
    else
        mkdir -p "$(dirname "${link}")"
        ln -s "${LINK_TARGET}" "${link}"
        echo "✅ 创建 ${link} -> ${LINK_TARGET}"
    fi
done

append_once() {
    FILE="$1"
    LINE="$2"
    if [ -f "${FILE}" ] && grep -qxF -- "${LINE}" "${FILE}"; then
        return 0
    fi
    mkdir -p "$(dirname "${FILE}")"
    if [ -s "${FILE}" ] && [ -n "$(tail -c 1 "${FILE}")" ]; then
        printf '\n' >> "${FILE}"
    fi
    printf '%s\n' "${LINE}" >> "${FILE}"
    echo "✅ ${FILE} 添加: ${LINE}"
}

if [ "${IN_GIT}" -eq 0 ]; then
    echo "ℹ️  项目不在 Git 仓库里，跳过忽略规则"
elif [ "${MODE}" = "team" ]; then
    append_once ".gitignore" "/.wiki/staging.md"
else
    append_once "${GIT_EXCLUDE}" "/${GIT_PREFIX}.wiki/"
    for link in ${LINKS}; do
        append_once "${GIT_EXCLUDE}" "/${GIT_PREFIX}${link}"
    done
fi

echo ""
echo "完成。新开一次会话，让运行时发现 ${ENTRY_NAME}。"
if [ "${MODE}" = "team" ]; then
    echo "请审阅后提交: ${DEST}/（以及 .gitignore、新建的入口链接，如有变化）"
fi
